<%- include('partials/header', { title: title }) %>

<section class="page-hero">
    <div class="container">
        <p class="eyebrow">Community Partners</p>

        <h1>Organizations</h1>

        <p>
            Discover organizations working to improve communities
            through service and volunteer opportunities.
        </p>
    </div>
</section>

<section class="section">
    <div class="container">

        <div class="organization-grid">

            <article class="organization-card">
                <img
                    src="/images/organization1.jpg"
                    alt="Volunteers working together in a community"
                >

                <div class="card-content">
                    <h2>Community Development Organization</h2>

                    <p>
                        Supports local development initiatives and
                        community improvement projects.
                    </p>

                    <a href="/projects" class="text-link">
                        View Projects →
                    </a>
                </div>
            </article>

            <article class="organization-card">
                <img
                    src="/images/organization2.jpg"
                    alt="People participating in an educational activity"
                >

                <div class="card-content">
                    <h2>Education Support Organization</h2>

                    <p>
                        Provides educational resources, mentoring,
                        and learning opportunities for young people.
                    </p>

                    <a href="/projects" class="text-link">
                        View Projects →
                    </a>
                </div>
            </article>

            <article class="organization-card">
                <img
                    src="/images/organization3.jpg"
                    alt="Community members participating in a health activity"
                >

                <div class="card-content">
                    <h2>Health and Wellness Organization</h2>

                    <p>
                        Promotes healthy living and supports community
                        health and wellness programs.
                    </p>

                    <a href="/projects" class="text-link">
                        View Projects →
                    </a>
                </div>
            </article>

        </div>

    </div>
</section>

<%- include('partials/footer') %>