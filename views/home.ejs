<%- include('partials/header', { title: title }) %>

<section class="hero">
    <div class="container hero-content">

        <div class="hero-text">
            <p class="eyebrow">Serve. Connect. Make a Difference.</p>

            <h1>Building stronger communities through service</h1>

            <p class="hero-description">
                Community Service Hub connects volunteers with organizations
                and meaningful service projects that create positive change.
            </p>

            <div class="hero-actions">
                <a href="/projects" class="button button-primary">
                    Explore Projects
                </a>

                <a href="/organizations" class="button button-secondary">
                    View Organizations
                </a>
            </div>
        </div>

    </div>
</section>

<section class="section">
    <div class="container">

        <div class="section-heading">
            <p class="eyebrow">Our Purpose</p>

            <h2>Making service easier and more accessible</h2>

            <p>
                Find opportunities to contribute your time, skills, and
                talents to projects that benefit individuals and communities.
            </p>
        </div>

        <div class="feature-grid">

            <article class="feature-card">
                <div class="feature-icon" aria-hidden="true">🤝</div>

                <h3>Connect</h3>

                <p>
                    Connect volunteers with organizations that need
                    support and community involvement.
                </p>
            </article>

            <article class="feature-card">
                <div class="feature-icon" aria-hidden="true">🌱</div>

                <h3>Serve</h3>

                <p>
                    Discover meaningful service projects that allow you
                    to make a positive difference.
                </p>
            </article>

            <article class="feature-card">
                <div class="feature-icon" aria-hidden="true">🌍</div>

                <h3>Impact</h3>

                <p>
                    Work together to create stronger, healthier, and
                    more connected communities.
                </p>
            </article>

        </div>
    </div>
</section>

<%- include('partials/footer') %>