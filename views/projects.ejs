<%- include('partials/header', { title: title }) %>

<section class="page-hero">

    <div class="container">

        <p class="eyebrow">
            Give Back
        </p>

        <h1>
            <%= title %>
        </h1>

        <p>
            Discover service projects and find an
            opportunity where you can make a difference.
        </p>

    </div>

</section>


<section class="section">

    <div class="container">

        <div class="project-grid">

            <% if (projects.length > 0) { %>

                <% projects.forEach(project => { %>

                    <article class="project-card">

                        <div class="card-content">

                            <h2>
                                <%= project.title %>
                            </h2>

                            <p>
                                <%= project.description %>
                            </p>

                            <p>
                                <strong>
                                    Organization:
                                </strong>

                                <%= project.organization_name %>
                            </p>

                            <p>
                                <strong>
                                    Location:
                                </strong>

                                <%= project.location %>
                            </p>

                            <p>
                                <strong>
                                    Date:
                                </strong>

                                <%= project.date %>
                            </p>

                        </div>

                    </article>

                <% }); %>

            <% } else { %>

                <p>
                    No service projects are currently available.
                </p>

            <% } %>

        </div>

    </div>

</section>


<%- include('partials/footer') %>