<%- include('partials/header', { title: title }) %>

<section class="page-hero">

    <div class="container">

        <p class="eyebrow">
            Find Your Opportunity
        </p>

        <h1>
            <%= title %>
        </h1>

        <p>
            Explore service project categories and find
            an opportunity that matches your interests
            and skills.
        </p>

    </div>

</section>


<section class="section">

    <div class="container">

        <div class="category-grid">

            <% if (categories.length > 0) { %>

                <% categories.forEach(category => { %>

                    <article class="category-card">

                        <div
                            class="category-icon"
                            aria-hidden="true"
                        >
                            📌
                        </div>

                        <h2>
                            <%= category.name %>
                        </h2>

                    </article>

                <% }); %>

            <% } else { %>

                <p>
                    No service project categories
                    are currently available.
                </p>

            <% } %>

        </div>

    </div>

</section>


<%- include('partials/footer') %>